<div class="circles-card" id="@Id">
    <div class="d-flex flex-column align-items-center gap-2">
        @if (Inverted)
        {
            <div class="d-flex flex-row justify-content-center align-items-center gap-2">
                @foreach (var n in TopRowInverted)
                {
                    <div class="num-circle" data-num="@n">@n</div>
                }
            </div>
            <div class="d-flex flex-row justify-content-center align-items-center gap-2">
                @foreach (var n in BottomRowInverted)
                {
                    <div class="num-circle" data-num="@n">@n</div>
                }
            </div>
        }
        else
        {
            <div class="d-flex flex-row justify-content-center align-items-center gap-2">
                @foreach (var n in TopRowStandard)
                {
                    <div class="num-circle" data-num="@n">@n</div>
                }
            </div>
            <div class="d-flex flex-row justify-content-center align-items-center gap-2">
                @foreach (var n in BottomRowStandard)
                {
                    <div class="num-circle" data-num="@n">@n</div>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public string Id { get; set; } = "circles-top";
    [Parameter] public bool Inverted { get; set; }

    private static readonly int[] TopRowInverted = [7, 8, 9, 10, 11, 12];
    private static readonly int[] BottomRowInverted = [2, 3, 4, 5, 6];

    private static readonly int[] TopRowStandard = [2, 3, 4, 5, 6];
    private static readonly int[] BottomRowStandard = [7, 8, 9, 10, 11, 12];
}
