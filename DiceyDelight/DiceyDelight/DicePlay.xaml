<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DiceyDelight.DicePlay"
             Padding="0">

    <ContentPage.Content>
        <AbsoluteLayout>
            <!-- Background Image -->
            <Image Source="Dice2.jpg"
                   Aspect="AspectFill" 
                   AbsoluteLayout.LayoutBounds="0, 0, 1, 1" 
                   AbsoluteLayout.LayoutFlags="All" />

            <BoxView Color="#CC000000"
                     AbsoluteLayout.LayoutBounds="0, 0, 1, 1"
                     AbsoluteLayout.LayoutFlags="All" />

            <!-- Main Game Layout -->
            <Grid AbsoluteLayout.LayoutBounds="0, 0, 1, 1"
                  AbsoluteLayout.LayoutFlags="All"
                  RowSpacing="8"
                  ColumnSpacing="0">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header: Top Bar -->
                <StackLayout Grid.Row="0" 
                             Orientation="Horizontal" 
                             BackgroundColor="#DD2C3E50" 
                             Padding="15,10" 
                             Spacing="20">
                    <Label x:Name="HighestScoreDisplay" 
                           Text="Highest Score: 0" 
                           FontSize="16" 
                           FontAttributes="Bold"
                           TextColor="#FFD700" />
                    <Label x:Name="DifficultyLevelDisplay" 
                           Text="Difficulty: " 
                           FontSize="16" 
                           FontAttributes="Bold"
                           TextColor="#ECF0F1" />
                </StackLayout>

                <!-- Computer Turn Indicator -->
                <BoxView x:Name="ComputerTurnIndicator" 
                         Grid.Row="1"
                         HeightRequest="4" 
                         BackgroundColor="Transparent"
                         HorizontalOptions="FillAndExpand" />

                <!-- Computer Section -->
                <StackLayout Grid.Row="2" 
                             Orientation="Horizontal" 
                             HorizontalOptions="Center"
                             Spacing="30"
                             Padding="10,5">
                    <Label x:Name="ComputerNameLabel" 
                           Text="COMPUTER" 
                           FontSize="20" 
                           FontAttributes="Bold"
                           TextColor="#ECF0F1"/>
                    <StackLayout Orientation="Vertical" Spacing="4">
                        <Label x:Name="ComputerTimerLabel" 
                               Text="Timer: 0" 
                               FontSize="16" 
                               TextColor="#ECF0F1"/>
                        <Label x:Name="ComputerScoreLabel" 
                               Text="Current Score: 0" 
                               FontSize="16" 
                               TextColor="#ECF0F1"/>
                    </StackLayout>
                </StackLayout>

                <!-- Computer Number Boxes Grid -->
                <Grid x:Name="NumberBoxesGrid" 
                      Grid.Row="3" 
                      HorizontalOptions="Center" 
                      VerticalOptions="Center"
                      RowSpacing="8"
                      ColumnSpacing="8"
                      Padding="20,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                </Grid>

                <!-- Spacer -->
                <BoxView Grid.Row="4" HeightRequest="10" />

                <!-- Dice Section -->
                <StackLayout Grid.Row="5" 
                             Orientation="Horizontal" 
                             HorizontalOptions="Center" 
                             Spacing="30"
                             Padding="10">
                    <StackLayout x:Name="DiceBox1" 
                                 WidthRequest="60" 
                                 HeightRequest="60" 
                                 BackgroundColor="#FFF8E7" 
                                 HorizontalOptions="Center" 
                                 VerticalOptions="Center">
                    </StackLayout>
                    <StackLayout x:Name="DiceBox2" 
                                 WidthRequest="60" 
                                 HeightRequest="60" 
                                 BackgroundColor="#FFF8E7" 
                                 HorizontalOptions="Center" 
                                 VerticalOptions="Center">
                    </StackLayout>
                    <StackLayout x:Name="DiceBox3" 
                                 WidthRequest="60" 
                                 HeightRequest="60" 
                                 BackgroundColor="#FFF8E7" 
                                 HorizontalOptions="Center" 
                                 VerticalOptions="Center">
                    </StackLayout>
                </StackLayout>

                <!-- Roll Button -->
                <StackLayout Grid.Row="6" 
                             HorizontalOptions="Center"
                             Padding="20,10">
                    <Button x:Name="RollButton" 
                            Text="ROLL" 
                            WidthRequest="120" 
                            HeightRequest="50" 
                            BackgroundColor="#E74C3C" 
                            TextColor="White" 
                            FontSize="20"
                            FontAttributes="Bold"
                            CornerRadius="35"
                            Clicked="RollButton_Clicked" />
                </StackLayout>

                <!-- Player Number Boxes Grid -->
                <Grid x:Name="PlayerNumberBoxesGrid" 
                      Grid.Row="7" 
                      HorizontalOptions="Center" 
                      VerticalOptions="Center"
                      RowSpacing="8"
                      ColumnSpacing="8"
                      Padding="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                </Grid>

                <!-- Player Section -->
                <StackLayout Grid.Row="8" 
                             Orientation="Horizontal" 
                             HorizontalOptions="Center"
                             Spacing="30"
                             Padding="20,10">
                    <Label x:Name="PlayerNameLabel" 
                           FontSize="20" 
                           FontAttributes="Bold"
                           TextColor="#ECF0F1"/>
                    <StackLayout Orientation="Vertical" Spacing="4">
                        <Label x:Name="PlayerScoreLabel" 
                               Text="Current Score: 0" 
                               FontSize="16" 
                               TextColor="#ECF0F1"/>
                        <Label x:Name="PlayerTimerLabel" 
                               Text="Timer: 0" 
                               FontSize="16" 
                               TextColor="#ECF0F1"/>
                    </StackLayout>
                </StackLayout>

                <!-- Player Turn Indicator -->
                <BoxView x:Name="PlayerTurnIndicator" 
                         Grid.Row="9"
                         HeightRequest="4" 
                         BackgroundColor="Transparent"
                         HorizontalOptions="FillAndExpand" />

            </Grid>
        </AbsoluteLayout>
    </ContentPage.Content>
</ContentPage>
    