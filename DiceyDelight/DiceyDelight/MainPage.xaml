<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DiceyDelight.MainPage"
             Title="DiceyDelight">

    <ContentPage.Content>
        <AbsoluteLayout>
            <Image Source="Dice2.jpg"
                   Aspect="AspectFill" 
                   AbsoluteLayout.LayoutBounds="0, 0, 1, 1" 
                   AbsoluteLayout.LayoutFlags="All" />

            <BoxView Color="#80000000"
                     AbsoluteLayout.LayoutBounds="0, 0, 1, 1"
                     AbsoluteLayout.LayoutFlags="All" />

            <!-- Main Content -->
            <StackLayout Padding="30, 60, 30, 30"
                         Spacing="25"
                         VerticalOptions="Center"
                         AbsoluteLayout.LayoutBounds="0.5, 0.5, AutoSize, AutoSize" 
                         AbsoluteLayout.LayoutFlags="PositionProportional">

                <StackLayout Spacing="5">
                    <Label Text="ENTER YOUR NAME"
                           FontSize="10"
                           FontAttributes="Bold"
                           HorizontalOptions="Start"
                           TextColor="#FFD700"
                           HorizontalTextAlignment="Center" />

                    <Entry x:Name="NameInput"
                           Placeholder="your name here"
                           PlaceholderColor="#BDBDBD"
                           TextColor="#F5F5F5"
                           FontSize="20"
                           WidthRequest="300"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                </StackLayout>

                <!-- Difficulty Selection -->
                <Label Text="⚡ SELECT DIFFICULTY ⚡"
                       HorizontalOptions="Center" 
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="#FFD700"
                       HorizontalTextAlignment="Center" />

                <!-- Difficulty Buttons -->
                <Button Text="EASY"
                        BackgroundColor="#2ECC71"
                        TextColor="White"
                        FontSize="16"
                        FontAttributes="Bold"
                        WidthRequest="300"
                        HorizontalOptions="Center"
                        Clicked="OnEasyClicked" />

                <Button Text="INTERMEDIATE"
                        BackgroundColor="#F39C12"
                        TextColor="White"
                        FontSize="16"
                        FontAttributes="Bold"
                        WidthRequest="300"
                        HorizontalOptions="Center"
                        Clicked="OnIntermediateClicked" />

                <Button Text="HARD"
                        BackgroundColor="#E74C3C"
                        TextColor="White"
                        FontSize="16"
                        FontAttributes="Bold"
                        WidthRequest="300"
                        HorizontalOptions="Center"
                        Clicked="OnHardClicked" />

                <!-- Divider -->
                <BoxView HeightRequest="5" 
                         BackgroundColor="#FFD700" 
                         WidthRequest="300"
                         HorizontalOptions="Center" />

                <!-- Score and Reset Section -->
                <StackLayout Orientation="Horizontal" 
                             Spacing="16"
                             HorizontalOptions="Fill">
                    <Label x:Name="HighestScoreLabel" 
                           Text="🏆 HIGHEST SCORE: 0" 
                           FontSize="15"
                           FontAttributes="Bold"
                           HorizontalOptions="StartAndExpand" 
                           TextColor="White"
                           VerticalOptions="Center" />

                    <Button Text="RESET"
                            BackgroundColor="#555555"
                            TextColor="White"
                            FontSize="16"
                            FontAttributes="Bold"
                            WidthRequest="90"
                            HorizontalOptions="End"
                            VerticalOptions="Center"
                            Clicked="OnResetClicked" />
                </StackLayout>
            </StackLayout>
        </AbsoluteLayout>

    </ContentPage.Content>
</ContentPage>
    